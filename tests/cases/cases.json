{
  "_note": "Expected values below are computed BY HAND from game.contract.json tuning (speed 6 m/s = 0.1 m/tick, shade 3 m/s = 0.05 m/tick, invuln 90 ticks, cooldown 60 ticks, stun 180 ticks, etc.). Never paste them from game output.",
  "cases": [
    {
      "name": "pickup_mote",
      "covers": ["R2"],
      "why": "Mote 0.5 m away (<= pickup_radius 1.0) is picked on tick 1; +10 score.",
      "args": { "seed": 1, "ticks": 3 },
      "scenario": { "random_motes": false, "random_shades": false, "motes": [[0.5, 0]] },
      "expect": {
        "events": [{ "tick": 1, "name": "mote_picked", "data": { "carried": 1 } }],
        "end": { "ticks": 3, "state": "playing", "score": 10 }
      }
    },
    {
      "name": "pickup_out_of_range_and_full",
      "covers": ["R2"],
      "why": "Mote at 1.5 m (> 1.0) is ignored; with carried = capacity (5) a near mote is ignored too.",
      "args": { "seed": 1, "ticks": 5 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "carried": 5 },
        "motes": [[0.5, 0], [1.5, 0]]
      },
      "expect": {
        "events": [],
        "end": { "ticks": 5, "state": "playing", "score": 0 },
        "snapshots": [{ "tick": 5, "match": { "motes_active": 2, "player": { "carried": 5 } } }]
      },
      "snapshot_every": 5
    },
    {
      "name": "deposit_and_light",
      "covers": ["R3"],
      "why": "Carrying 5 = lantern_cost at 1 m from L1; interact on tick 2 (event tick 3) deposits 5 and lights L1; +100.",
      "args": { "seed": 1, "ticks": 5 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "pos": [14, 0], "carried": 5 },
        "motes": []
      },
      "inputs": { "frames": [{ "tick": 2, "interact": true }, { "tick": 3, "interact": false }] },
      "expect": {
        "events": [
          { "tick": 3, "name": "deposit", "data": { "lantern_id": "L1", "amount": 5, "deposited": 5 } },
          { "tick": 3, "name": "lantern_lit", "data": { "lantern_id": "L1" } }
        ],
        "end": { "ticks": 5, "state": "playing", "score": 100 }
      }
    },
    {
      "name": "deposit_partial",
      "covers": ["R3"],
      "why": "Carrying 3 deposits 3, lantern not lit, no lantern_lit, score 0.",
      "args": { "seed": 1, "ticks": 4 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "pos": [14, 0], "carried": 3 },
        "motes": []
      },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "expect": {
        "events": [{ "tick": 1, "name": "deposit", "data": { "lantern_id": "L1", "amount": 3, "deposited": 3 } }],
        "end": { "ticks": 4, "state": "playing", "score": 0 }
      }
    },
    {
      "name": "deposit_out_of_range",
      "covers": ["R3"],
      "why": "Player 3 m from L1 (> interact_radius 2.5): interact does nothing.",
      "args": { "seed": 1, "ticks": 3 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "pos": [12, 0], "carried": 5 },
        "motes": []
      },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "expect": { "events": [], "end": { "ticks": 3, "state": "playing", "score": 0 } }
