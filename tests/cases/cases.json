    {
      "name": "win_all_lit",
      "covers": ["R4", "R10"],
      "why": "L2..L5 pre-lit (no points). Lighting L1 on tick 1: 100 + 1*floor(100 - 1/60 = 99.98 -> 99) + 50*3 flames = 349. Game stops at tick 1.",
      "args": { "seed": 1, "ticks": 100 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "time_left_s": 100,
        "player": { "pos": [14, 0], "carried": 5 },
        "motes": [],
        "lanterns": [
          { "id": "L2", "lit": true },
          { "id": "L3", "lit": true },
          { "id": "L4", "lit": true },
          { "id": "L5", "lit": true }
        ]
      },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "expect": {
        "events": [
          { "tick": 1, "name": "deposit", "data": { "lantern_id": "L1", "amount": 5, "deposited": 5 } },
          { "tick": 1, "name": "lantern_lit", "data": { "lantern_id": "L1" } },
          { "tick": 1, "name": "game_over", "data": { "result": "won", "reason": "all_lit" } }
        ],
        "end": { "ticks": 1, "state": "won", "score": 349 }
      }
    },
    {
      "name": "shade_hits_until_lost",
      "covers": ["R5", "R6"],
      "why": "Shade 0.5 m away, player carries 4. Hit tick 1: flames 2, drop floor(4*0.5)=2. Invuln 90 ticks -> next hit tick 91: flames 1, carried 2 -> drop 1. Tick 181: flames 0, carried 1 -> drop 0, game over no_flames.",
      "args": { "seed": 1, "ticks": 300 },
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "carried": 4 },
        "motes": [],
        "shades": [{ "id": "A", "pos": [0.5, 0.5, 0] }]
      },
      "expect": {
        "events": [
          { "tick": 1, "name": "player_hit", "data": { "by": "shade", "flames": 2, "dropped": 2 } },
          { "tick": 91, "name": "player_hit", "data": { "by": "shade", "flames": 1, "dropped": 1 } },
          { "tick": 181, "name": "player_hit", "data": { "by": "shade", "flames": 0, "dropped": 0 } },
          { "tick": 181, "name": "game_over", "data": { "result": "lost", "reason": "no_flames" } }
        ],
        "end": { "ticks": 181, "state": "lost", "score": 0 }
      }
    },
    {
      "name": "dawn_loss",
      "covers": ["R7"],
      "why": "time_left_s 0.05 = 3 ticks; at tick 3 the night ends: lost / dawn.",
      "args": { "seed": 1, "ticks": 10 },
      "scenario": { "random_motes": false, "random_shades": false, "time_left_s": 0.05, "motes": [] },
      "expect": {
