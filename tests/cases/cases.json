    {
      "name": "pulse_stuns_in_radius",
      "covers": ["R8"],
      "why": "Shade A at 3 m (<= 6) is stunned and pushed 2 m away (x=5); shade B at 10 m is untouched and chases (10 - 5*0.05 = 9.75 at tick 5). Pulse costs 1 carried, +20 per stun.",
      "args": { "seed": 1, "ticks": 5 },
      "snapshot_every": 5,
      "scenario": {
        "random_motes": false,
        "random_shades": false,
        "player": { "carried": 1 },
        "motes": [],
        "shades": [
          { "id": "A", "pos": [3, 0.5, 0] },
          { "id": "B", "pos": [10, 0.5, 0] }
        ]
      },
      "inputs": { "frames": [{ "tick": 0, "pulse": true }] },
      "expect": {
        "events": [{ "tick": 1, "name": "pulse", "data": { "stunned_ids": ["A"] } }],
        "end": { "ticks": 5, "state": "playing", "score": 20 },
        "snapshots": [
          {
            "tick": 5,
            "match": {
              "player": { "carried": 0 },
              "shades": [
                { "id": "A", "pos": [5, 0.5, 0], "state": "stunned" },
                { "id": "B", "pos": [9.75, 0.5, 0], "state": "chasing" }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "pulse_cooldown_and_miss",
      "covers": ["R8"],
      "why": "Carry 2. Pulse at tick 0 (event 1) hits nothing but still costs 1. Pulse at tick 10 is within the 60-tick cooldown: ignored. Pulse at tick 70 (event tick 71 >= 61) is allowed, carried -> 0.",
      "args": { "seed": 1, "ticks": 80 },
      "snapshot_every": 80,
      "scenario": { "random_motes": false, "random_shades": false, "player": { "carried": 2 }, "motes": [] },
      "inputs": {
        "frames": [
          { "tick": 0, "pulse": true },
          { "tick": 1, "pulse": false },
          { "tick": 10, "pulse": true },
          { "tick": 11, "pulse": false },
          { "tick": 70, "pulse": true }
        ]
      },
      "expect": {
        "events": [
          { "tick": 1, "name": "pulse", "data": { "stunned_ids": [] } },
          { "tick": 71, "name": "pulse", "data": { "stunned_ids": [] } }
        ],
        "end": { "ticks": 80, "state": "playing", "score": 0 },
        "snapshots": [{ "tick": 80, "match": { "player": { "carried": 0 } } }]
      }
    },
